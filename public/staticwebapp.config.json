{
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/assets/*", "*.svg", "*.js", "*.css", "*.webp"] },
  "routes": [
    { "route": "/assets/*.js", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*.css", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*.webp", "headers": { "Cache-Control": "public, max-age=86400" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), camera=(), microphone=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self' https://api.sociobot.in; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  },
  "mimeTypes": { ".gpx": "application/gpx+xml" }
}
