{
  "routes": [
    { "route": "/assets/*.js", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*.css", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*.webp", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/assets/*.jpg", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/demo", "redirect": "/demo/", "statusCode": 301 },
    { "route": "/privacy", "redirect": "/privacy/", "statusCode": 301 },
    { "route": "/terms", "redirect": "/terms/", "statusCode": 301 }
  ],
  "responseOverrides": { "404": { "rewrite": "/404.html" } },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), camera=(), microphone=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https://api.sociobot.in; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  },
  "mimeTypes": { ".gpx": "application/gpx+xml" }
}
